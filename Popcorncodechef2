import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		int amt = sc.nextInt();
		if(amt < 150)  System.out.println(0);
		else {
		    int res = (amt - 100) / 50;
		    System.out.println(res);
		}

	}
}
